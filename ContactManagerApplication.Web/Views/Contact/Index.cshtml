@model IEnumerable<ContactManagerApplication.Domain.Entities.Contact>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div>
    <form asp-controller="Contact" asp-action="UploadCsvFile" method="post" enctype="multipart/form-data">
        <input type="file" name="file" />
        <button type="submit">Upload</button>
    </form>
</div>

<table id="contactsTable" class="display">
    <thead>
    <tr>
        <th>Name</th>
        <th>Date of Birth</th>
        <th>Married</th>
        <th>Phone</th>
        <th>Salary</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var contact in Model)
    {
        <tr data-id="@contact.Id" data-modified="false">
            <td contenteditable="true" data-column="Name" data-id="@contact.Id">@contact.Name</td>
            <td contenteditable="true" data-column="DateOfBirth" data-id="@contact.Id">@contact.DateOfBirth.ToShortDateString()</td>
            <td>
                <input type="checkbox" data-column="Married" data-id="@contact.Id" @(contact.Married ? "checked" : "") />
            </td>
            <td contenteditable="true" data-column="Phone" data-id="@contact.Id">@contact.Phone</td>
            <td contenteditable="true" data-column="Salary" data-id="@contact.Id">@contact.Salary</td>
            <td>
                <button onclick="contactManager.deleteContact(@contact.Id)">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

